[MASTER]
ignore=.venv,venv,build,dist,.pytest_cache

[MESSAGES CONTROL]
disable=
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    too-few-public-methods,
    too-many-arguments,
    too-many-locals,
    too-many-instance-attributes,
    too-many-branches,
    too-many-statements,
    too-many-return-statements,
    import-outside-toplevel,
    duplicate-code,
    invalid-name

[FORMAT]
max-line-length=120
