# ==================== Whitelist (only these are tracked) ====================
# Allowed: scripts/, src/, tests/, requirements.txt, README.md, .gitignore
# Everything else is ignored below.

# ==================== Ignore everything by default ====================
/*

# ==================== Whitelist specific paths ====================
!.gitignore
!README.md
!requirements.txt
!scripts/
!src/
!tests/
!configs/
!docs/
!Dockerfile
!docker-compose.yml
!setup.py
!setup.cfg
!pytest.ini
!.coveragerc
!.pylintrc
!API_DOCUMENTATION.md
!CHANGELOG.md
!LICENSE

# ==================== Python bytecode (within whitelisted dirs) ====================
__pycache__/
*.py[cod]
*$py.class

# ==================== Coverage data ====================
.coverage
.coverage.*
htmlcov/
.tox/
