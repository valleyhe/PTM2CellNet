# ==================== Whitelist (only these are tracked) ====================
# Allowed: scripts/, src/, tests/, requirements.txt, README.md, .gitignore
# Everything else is ignored below.

# ==================== Ignore everything by default ====================
/*

# ==================== Whitelist specific paths ====================
!.gitignore
!README.md
!requirements.txt
!requirements-core.txt
!requirements-pretrained.txt
!requirements-mamba.txt
!requirements-analysis.txt
!requirements-dev.txt
!requirements-lock.txt
!pyproject.toml
!.github/
/.github/*
!.github/workflows/
/.github/workflows/*
!.github/workflows/ci.yml
!.github/workflows/full-test.yml
!.github/workflows/perturbgen-real-assets.yml
!scripts/
!src/
!tests/
!configs/
!environments/
environments/*
!environments/kstar/
environments/kstar/*
!environments/kstar/environment.yml
!environments/kstar/resource_hashes.json
!environments/kstar/requirements-lock.txt
!docs/
!Dockerfile
!docker-compose.yml
!setup.py
!setup.cfg
!pytest.ini
!.coveragerc
!.pylintrc
!API_DOCUMENTATION.md
!project_analysis_*.md
!project_repair_*.md
!CHANGELOG.md
!LICENSE
!archive/
!archive/**
!data/
data/*
!data/manifests/
!data/manifests/**

# ==================== Python bytecode (within whitelisted dirs) ====================
__pycache__/
*.py[cod]
*$py.class

# ==================== Coverage data ====================
.coverage
.coverage.*
htmlcov/
.tox/
docs/_build/
!archive/**/.coverage
!archive/**/.coverage.*
